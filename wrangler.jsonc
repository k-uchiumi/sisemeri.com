{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sisemeri-com",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// 公開は sisemeri.com のみ（ダッシュボードでオフにしても、デプロイのたびに既定値でオンに戻るため明示する）
	"workers_dev": false,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sisemeri",
		},
	],
	"send_email": [{ "name": "EMAIL" }],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "sisemeri-media",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
